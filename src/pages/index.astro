---
import MainLayout from '../layout/Main.astro';
import { getSlugsByCode, FALLBACK_COUNTRY } from '../lib/atomydata';

const slugs = getSlugsByCode();
const fallbackSlug = slugs[FALLBACK_COUNTRY];

const messages: Record<string, string> = {
    en: 'Loading your information…',
    es: 'Cargando tu información…',
    pt: 'Carregando suas informações…',
    de: 'Deine Informationen werden geladen…',
    ja: '情報を読み込んでいます…',
    ko: '정보를 불러오는 중…',
    'zh-Hans': '正在加载您的信息…',
    'zh-Hant': '正在載入您的資訊…',
    th: 'กำลังโหลดข้อมูลของคุณ…',
    km: 'កំពុងផ្ទុកព័ត៌មានរបស់អ្នក…',
    id: 'Memuat informasi Anda…',
    ru: 'Загрузка информации…',
    mn: 'Таны мэдээллийг ачаалж байна…',
    uz: 'Ma\'lumotlaringiz yuklanmoqda…',
    tr: 'Bilgileriniz yükleniyor…',
};
---
<MainLayout
    title="Atomy | Free membership"
    description="Claim your free Atomy membership. Quality products, exclusive benefits and a global community."
    lang="en"
>
    <main class="flex min-h-screen flex-col items-center justify-center gap-8 px-6">
        <img src="/logo-atomy.svg" alt="Atomy" width="220" height="110" class="w-48 sm:w-56" />
        <div class="flex flex-col items-center gap-4">
            <span
                class="size-10 animate-spin rounded-full border-4 border-atomy/25 border-t-atomy motion-reduce:animate-none"
                role="status"
                aria-live="polite"
            ></span>
            <p id="loading-message" class="text-lg font-light text-slate-500">Loading your information…</p>
        </div>
        <noscript>
            <a href={`/atomy/${fallbackSlug}/`} class="font-medium text-atomy underline">Continue</a>
        </noscript>
    </main>

    <script is:inline define:vars={{ slugs, messages, fallbackSlug }}>
        function pickMessage() {
            const languages = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
            for (const tag of languages) {
                if (messages[tag]) return messages[tag];
                const base = tag.toLowerCase().split('-')[0];
                if (base === 'zh') return tag.toLowerCase().includes('hant') ? messages['zh-Hant'] : messages['zh-Hans'];
                const match = Object.keys(messages).find((key) => key.toLowerCase().split('-')[0] === base);
                if (match) return messages[match];
            }
            return messages.en;
        }

        document.getElementById('loading-message').textContent = pickMessage();

        async function detectCountry() {
            try {
                const response = await fetch('https://api.ipquery.io/?format=json', {
                    signal: AbortSignal.timeout(3000),
                });
                if (!response.ok) return null;
                const payload = await response.json();
                return payload?.location?.country_code ?? null;
            } catch {
                return null;
            }
        }

        detectCountry().then((code) => {
            location.replace(`/atomy/${slugs[code] ?? fallbackSlug}/`);
        });
    </script>
</MainLayout>
